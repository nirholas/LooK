# Copy this file to .env and fill in what you need:
#   cp .env.example .env
# The CLI (`look demo`, `look quick`) needs at most one AI provider key.
# The rest are only used by the hosted server (`look serve`).

# --- AI providers ---
# Used for script generation and narration. Set whichever provider you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# --- Server ---
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
# Public origin of the deployment, used to build absolute links.
BASE_URL=http://localhost:3000
# Comma-separated list of allowed browser origins. CORS_ORIGIN is the
# single-value form; CORS_ORIGINS takes a list.
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Set to any value to enable verbose debug output.
DEBUG=

# --- Database ---
# SQLite file path. Created automatically from src/db/schema.sql on first run.
DATABASE_PATH=./data/look.db

# --- Auth ---
# REQUIRED in production. Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# OAuth client IDs for social sign-in (optional).
GITHUB_CLIENT_ID=
GOOGLE_CLIENT_ID=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=

# --- Security ---
# Set to "false" to disable SSRF protection on user-supplied URLs. Keep it on
# for any deployment that accepts untrusted input.
ENABLE_SSRF_PROTECTION=true

# --- Headless capture (Linux) ---
# X11 / Wayland display used by Playwright when recording. Usually inherited
# from the environment; only set these when running under Xvfb.
DISPLAY=
WAYLAND_DISPLAY=
